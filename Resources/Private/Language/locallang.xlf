<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" datatype="plaintext" original="EXT:analytics_matomo/Resources/Private/Language/locallang.xlf" product-name="analytics_matomo">
		<header/>
		<body>
			<trans-unit id="bar.label" resname="bar.label">
				<source>Matomo statistics of this page</source>
			</trans-unit>
			<trans-unit id="bar.loading" resname="bar.loading">
				<source>Loading statistics from Matomo…</source>
			</trans-unit>
			<trans-unit id="bar.error" resname="bar.error">
				<source>The statistics could not be loaded from Matomo.</source>
			</trans-unit>
			<trans-unit id="bar.period" resname="bar.period">
				<source>Period</source>
			</trans-unit>
			<trans-unit id="bar.days" resname="bar.days">
				<source>Last %d days</source>
			</trans-unit>
			<trans-unit id="bar.daysAgo" resname="bar.daysAgo">
				<source>%d days ago</source>
			</trans-unit>
			<trans-unit id="bar.today" resname="bar.today">
				<source>Today</source>
			</trans-unit>
			<trans-unit id="bar.trend" resname="bar.trend">
				<source>Change compared to the %d days before</source>
			</trans-unit>
			<trans-unit id="bar.openMatomo" resname="bar.openMatomo">
				<source>Open Matomo</source>
			</trans-unit>
			<trans-unit id="bar.pageUrl" resname="bar.pageUrl">
				<source>Statistics for %s</source>
			</trans-unit>
			<trans-unit id="metric.views" resname="metric.views">
				<source>Page views</source>
			</trans-unit>
			<trans-unit id="metric.views.description" resname="metric.views.description">
				<source>How often this page was viewed.</source>
			</trans-unit>
			<trans-unit id="metric.bounceRate" resname="metric.bounceRate">
				<source>Bounce rate</source>
			</trans-unit>
			<trans-unit id="metric.bounceRate.description" resname="metric.bounceRate.description">
				<source>Share of visits that started on this page and left without viewing another page.</source>
			</trans-unit>
			<trans-unit id="metric.averageTimeOnPage" resname="metric.averageTimeOnPage">
				<source>Avg. time on page</source>
			</trans-unit>
			<trans-unit id="metric.averageTimeOnPage.description" resname="metric.averageTimeOnPage.description">
				<source>Average time visitors spent on this page, in minutes and seconds.</source>
			</trans-unit>
			<trans-unit id="metric.exitRate" resname="metric.exitRate">
				<source>Exit rate</source>
			</trans-unit>
			<trans-unit id="metric.exitRate.description" resname="metric.exitRate.description">
				<source>Share of views of this page after which the visit ended.</source>
			</trans-unit>
			<trans-unit id="settings.category" resname="settings.category">
				<source>Matomo statistics</source>
			</trans-unit>
			<trans-unit id="settings.url" resname="settings.url">
				<source>Matomo URL</source>
			</trans-unit>
			<trans-unit id="settings.url.description" resname="settings.url.description">
				<source>Base URL of your Matomo, e.g. https://matomo.example.com/. Empty: URL and site ID are taken together from EXT:matomo_integration, EXT:matomo_widgets or EXT:matomo_tracking.</source>
			</trans-unit>
			<trans-unit id="settings.idSite" resname="settings.idSite">
				<source>Matomo site ID</source>
			</trans-unit>
			<trans-unit id="settings.idSite.description" resname="settings.idSite.description">
				<source>ID of this website in Matomo. Required when the Matomo URL is set.</source>
			</trans-unit>
			<trans-unit id="settings.tokenAuth" resname="settings.tokenAuth">
				<source>Matomo auth token</source>
			</trans-unit>
			<trans-unit id="settings.tokenAuth.description" resname="settings.tokenAuth.description">
				<source>Token of a Matomo user with view access to this site. Use an environment variable, e.g. %env(MATOMO_TOKEN)%, instead of the plain token.</source>
			</trans-unit>
			<trans-unit id="permission.header" resname="permission.header">
				<source>Analytics for Matomo</source>
			</trans-unit>
			<trans-unit id="permission.pageStatistics" resname="permission.pageStatistics">
				<source>View page statistics</source>
			</trans-unit>
			<trans-unit id="permission.pageStatistics.description" resname="permission.pageStatistics.description">
				<source>Shows the Matomo statistics of the current page in the Page module.</source>
			</trans-unit>
			<trans-unit id="permission.siteStatistics" resname="permission.siteStatistics">
				<source>View site statistics</source>
			</trans-unit>
			<trans-unit id="permission.siteStatistics.description" resname="permission.siteStatistics.description">
				<source>Allows the Matomo dashboard widgets with the numbers of whole sites.</source>
			</trans-unit>
			<trans-unit id="widget.group" resname="widget.group">
				<source>Matomo</source>
			</trans-unit>
			<trans-unit id="widget.preset.title" resname="widget.preset.title">
				<source>Matomo overview</source>
			</trans-unit>
			<trans-unit id="widget.preset.description" resname="widget.preset.description">
				<source>Key figures, visitors over time, top pages and traffic sources from Matomo.</source>
			</trans-unit>
			<trans-unit id="widget.performance" resname="widget.performance">
				<source>Site performance</source>
			</trans-unit>
			<trans-unit id="widget.performance.description" resname="widget.performance.description">
				<source>Visits, page views, bounce rate and visit duration of a site, compared with the period before.</source>
			</trans-unit>
			<trans-unit id="widget.traffic" resname="widget.traffic">
				<source>Visits over time</source>
			</trans-unit>
			<trans-unit id="widget.traffic.description" resname="widget.traffic.description">
				<source>Visits, visitors, new and returning visits per day.</source>
			</trans-unit>
			<trans-unit id="widget.traffic.chart" resname="widget.traffic.chart">
				<source>Visits per day of the last %s days</source>
			</trans-unit>
			<trans-unit id="widget.topPages" resname="widget.topPages">
				<source>Top pages</source>
			</trans-unit>
			<trans-unit id="widget.topPages.description" resname="widget.topPages.description">
				<source>The most viewed pages of a site with their share and trend.</source>
			</trans-unit>
			<trans-unit id="widget.channel" resname="widget.channel">
				<source>Channels</source>
			</trans-unit>
			<trans-unit id="widget.channel.description" resname="widget.channel.description">
				<source>Where visitors come from: search engines, websites, direct entry, campaigns and more.</source>
			</trans-unit>
			<trans-unit id="widget.devices" resname="widget.devices">
				<source>Devices</source>
			</trans-unit>
			<trans-unit id="widget.devices.description" resname="widget.devices.description">
				<source>Visits by device type.</source>
			</trans-unit>
			<trans-unit id="widget.browsers" resname="widget.browsers">
				<source>Browsers</source>
			</trans-unit>
			<trans-unit id="widget.browsers.description" resname="widget.browsers.description">
				<source>Visits by browser.</source>
			</trans-unit>
			<trans-unit id="widget.countries" resname="widget.countries">
				<source>Countries</source>
			</trans-unit>
			<trans-unit id="widget.countries.description" resname="widget.countries.description">
				<source>Visits by country.</source>
			</trans-unit>
			<trans-unit id="widget.site" resname="widget.site">
				<source>Site</source>
			</trans-unit>
			<trans-unit id="widget.page" resname="widget.page">
				<source>Page</source>
			</trans-unit>
			<trans-unit id="widget.change" resname="widget.change">
				<source>Change</source>
			</trans-unit>
			<trans-unit id="widget.other" resname="widget.other">
				<source>Other</source>
			</trans-unit>
			<trans-unit id="widget.noData" resname="widget.noData">
				<source>No visits in this period.</source>
			</trans-unit>
			<trans-unit id="widget.noSite" resname="widget.noSite">
				<source>No site with a Matomo connection is available to you.</source>
			</trans-unit>
			<trans-unit id="widget.noAccess" resname="widget.noAccess">
				<source>You are not allowed to view site statistics.</source>
			</trans-unit>
			<trans-unit id="metric.visits" resname="metric.visits">
				<source>Visits</source>
			</trans-unit>
			<trans-unit id="siteMetric.visits.description" resname="siteMetric.visits.description">
				<source>Number of visits to the site. A visit ends after 30 minutes without activity.</source>
			</trans-unit>
			<trans-unit id="metric.pageViews" resname="metric.pageViews">
				<source>Page views</source>
			</trans-unit>
			<trans-unit id="siteMetric.pageViews.description" resname="siteMetric.pageViews.description">
				<source>Number of pages viewed on the site.</source>
			</trans-unit>
			<trans-unit id="metric.averageTimeOnSite" resname="metric.averageTimeOnSite">
				<source>Avg. visit duration</source>
			</trans-unit>
			<trans-unit id="siteMetric.averageTimeOnSite.description" resname="siteMetric.averageTimeOnSite.description">
				<source>Average time a visit lasts.</source>
			</trans-unit>
			<trans-unit id="metric.visitors" resname="metric.visitors">
				<source>Visitors</source>
			</trans-unit>
			<trans-unit id="metric.newVisits" resname="metric.newVisits">
				<source>New visits</source>
			</trans-unit>
			<trans-unit id="metric.returningVisits" resname="metric.returningVisits">
				<source>Returning visits</source>
			</trans-unit>
			<trans-unit id="siteMetric.bounceRate.description" resname="siteMetric.bounceRate.description">
				<source>Share of visits that left the site after one page.</source>
			</trans-unit>
			<trans-unit id="settings.demoData" resname="settings.demoData">
				<source>Demo data</source>
			</trans-unit>
			<trans-unit id="settings.demoData.description" resname="settings.demoData.description">
				<source>Shows generated statistics instead of asking Matomo, e.g. to try out the extension or to take screenshots. Never enable on a production site.</source>
			</trans-unit>
		</body>
	</file>
</xliff>
