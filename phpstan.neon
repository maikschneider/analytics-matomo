includes:
	- phpstan-baseline.neon

parameters:
		parallel:
				maximumNumberOfProcesses: 5

		level: 8

		bootstrapFiles:
				- vendor/autoload.php

		paths:
				- Classes
				- Configuration
				- Tests

		typo3:
				requestGetAttributeMapping:
						# Core attribute of the Page module since TYPO3 v14, absent in v13
						pageContext: TYPO3\CMS\Backend\Context\PageContext|null
