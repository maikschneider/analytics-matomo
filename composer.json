{
	"name": "maikschneider/analytics-matomo",
	"description": "Shows Matomo statistics in the TYPO3 Page module and on the dashboard.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"typo3-cms-extension",
		"matomo",
		"analytics",
		"statistics",
		"backend"
	],
	"authors": [
		{
			"name": "Maik Schneider",
			"email": "schneider.maik@me.com",
			"role": "Developer"
		}
	],
	"homepage": "https://extensions.typo3.org/extension/analytics_matomo",
	"support": {
		"issues": "https://github.com/maikschneider/analytics-matomo/issues",
		"source": "https://github.com/maikschneider/analytics-matomo",
		"docs": "https://docs.typo3.org/p/maikschneider/analytics-matomo/main/en-us/"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^13.4 || ^14.3",
		"typo3/cms-core": "^13.4 || ^14.3",
		"typo3/cms-dashboard": "^13.4 || ^14.3",
		"typo3/cms-fluid": "^13.4 || ^14.3"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.1",
		"ergebnis/composer-normalize": "^2.45",
		"friendsofphp/php-cs-fixer": "^3.64",
		"move-elevator/composer-translation-validator": "^1.3",
		"phpstan/extension-installer": "^1.3",
		"saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
		"ssch/typo3-rector": "^3.0",
		"symfony/translation": "^7.2",
		"symfony/yaml": "^7.2",
		"typo3/cms-install": "^13.4 || ^14.3",
		"typo3/cms-reports": "^13.4 || ^14.3",
		"typo3/cms-scheduler": "^13.4 || ^14.3",
		"typo3/testing-framework": "^9.5"
	},
	"autoload": {
		"psr-4": {
			"MaikSchneider\\AnalyticsMatomo\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MaikSchneider\\AnalyticsMatomo\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"move-elevator/composer-translation-validator": true,
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"lock": false,
		"sort-packages": true,
		"vendor-dir": "vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "analytics_matomo",
			"version": "0.1.0",
			"web-dir": "public"
		}
	},
	"scripts": {
		"ci:composer:normalize": "@composer normalize --no-check-lock --dry-run",
		"ci:editorconfig:lint": "ec --strict --git-only -n",
		"ci:language:lint": "composer validate-translations Resources/Private/Language",
		"ci:php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix --dry-run --format=checkstyle > php-cs-fixer.xml",
		"ci:php:lint": "find *.php . -name '*.php' ! -path './vendor/*'  ! -path './var/*' ! -path '*node_modules/*' ! -path '*public/*' -print0 | xargs -0 -n 1 -P 4 php -l",
		"ci:php:rector": "rector --dry-run",
		"ci:php:stan": "phpstan --no-progress --error-format=checkstyle > phpstan.xml",
		"ci:sca": [
			"@ci:composer:normalize",
			"@ci:editorconfig:lint",
			"@ci:php:lint",
			"@ci:php:fixer",
			"@ci:php:stan",
			"@ci:php:rector",
			"@ci:language:lint",
			"@ci:yaml:lint"
		],
		"ci:yaml:lint": "find ./ ! -path './vendor/*' ! -path '*/node_modules/*' ! -path './.ddev/*' ! -path './public/*' ! -path './var/*' \\( -name '*.yaml' -o -name '*.yml' \\) | xargs -r yaml-lint",
		"composer:normalize": "@composer normalize --no-check-lock",
		"editorconfig:lint": "ec --strict --fix --git-only -n",
		"language:lint": "composer validate-translations Resources/Private/Language",
		"php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix",
		"php:lint": "find *.php . -name '*.php' ! -path './vendor/*'  ! -path './var/*' ! -path '*node_modules/*' ! -path '*public/*' -print0 | xargs -0 -n 1 -P 4 php -l",
		"php:rector": "rector",
		"php:stan": "phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
		"sca": [
			"@composer:normalize",
			"@editorconfig:lint",
			"@php:lint",
			"@php:fixer",
			"@php:stan",
			"@php:rector",
			"@language:lint",
			"@yaml:lint"
		],
		"yaml:lint": "find ./ ! -path './vendor/*' ! -path '*/node_modules/*' ! -path './.ddev/*' ! -path './public/*' ! -path './var/*' \\( -name '*.yaml' -o -name '*.yml' \\) | xargs -r yaml-lint"
	}
}
